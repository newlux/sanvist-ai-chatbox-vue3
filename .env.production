# 生产环境配置
 
VITE_WEB_ENV=production
VITE_H5_OUT_DIR=20260730
# 日志级别：debug/info/warn/error/silent。
# 排查期先开 debug，配合常开的 vConsole 看完整链路；稳定后改回 warn
VITE_LOG_LEVEL=debug
# 接口地址
# 外围发布测试版释放开
VITE_AI_QUESTION_BASE_URL='https://sanvist-api-dev.etripon.com/sanvist-ai-api'
# 内网发布正式版释放开
# VITE_AI_QUESTION_BASE_URL='https://sanvist-api-test.sany.com.cn/assistant'
# 国际化远程补充语言包地址
VITE_STATIC_BASE_URL='http://sanyme-1254375538.cos.ap-guangzhou.myqcloud.com/mysany-assets'

# 甘特图离线包 appid（mPaaS 离线包中心分配，H5 环境不使用）
VITE_GANTT_OFFLINE_APPID='20261103'
 
# 打包环境标识开关VITE_BAG_ENABLE_ENV（Y / N）：Y = 所有接口请求头带 `env: <VITE_WEB_ENV>`（本地即 env: development）；
# N = 不带该头，且调用方显式传的 env 也会被摘掉。值在构建期静态替换，改完要重新 build:h5（口径见 .env.production）
#展会版（默认）
VITE_BAG_ENABLE_ENV=Y
VITE_REMOTE_VOICE_KEY=Y
# 遥控器音量键触发语音输入VITE_REMOTE_VOICE_KEY（Y / N）：N = 不注册遥控器按键监听，
# 音量键回归系统调音量、返回键交回容器（口径见 hooks/useRemoteKey）
#生产版
# VITE_BAG_ENABLE_ENV=Y
# VITE_REMOTE_VOICE_KEY=N
