# 国际化远程补充语言包地址
VITE_STATIC_BASE_URL='http://sanyme-1254375538.cos.ap-guangzhou.myqcloud.com/mysany-assets'

# 甘特图离线包 appid（mPaaS 离线包中心分配，H5 环境不使用）
